# Base: none — root model
# Adds: nothing — this is a context for the data spec's examples, not a
#   modelling claim
# Changes: nothing else
#
# What this model is
# ------------------
# The smallest model an observation stream can be attached to: susceptible (S),
# infectious (I) and recovered (R), with `infection` moving a susceptible into
# I and `recovery` moving an infectious person into R. `origin` maps 1 July
# 2026 to model time t = 0, so an example file can state its times as ISO
# dates.
#
# What it is fitted to
# --------------------
# Nothing by itself. It carries no `observations { }` block: the data-spec
# example harness (`tests/data_spec_examples.rs`) appends the stream the
# document declares, so each documented file is bound under the declaration
# the document prints beside it. The parameters in `daily.params.toml` are
# whatever makes the run finite; no number here is an estimate.

time_unit = 'days
origin    = date("2026-07-01")

compartments { S, I, R }

parameters {
  beta  : rate        in [0.001, 5.0]
  gamma : rate        in [0.01, 1.0]
  rho   : probability in [0.01, 1.0]
}

let N = S + I + R

transitions {
  infection : S --> I  @ beta * S * I / N
  recovery  : I --> R  @ gamma * I
}

init { S = 4000  I = 20 }

simulate {
  from = 0 'days
  to   = 60 'days
}
