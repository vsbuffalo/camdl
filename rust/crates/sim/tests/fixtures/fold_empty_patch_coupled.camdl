# Control for fold_empty_patch.camdl (gh#1217): the same model, except that
# W[p1, p2] = 0.5, so patch p1's force of infection has a term that divides
# by the empty patch's N[p2] = 0 and is not structurally zero. The fold keeps
# that term, and the runtime still reports the division by zero, folded or
# not.
#
# Regenerate both .ir.json siblings with the camdlc under test:
#   CAMDL_NO_CONSTANT_FOLD=1 camdlc --set beta=0.3 --set gamma=0.1 fold_empty_patch_coupled.camdl > fold_empty_patch_coupled_unfolded.ir.json
#   camdlc --set beta=0.3 --set gamma=0.1 fold_empty_patch_coupled.camdl > fold_empty_patch_coupled_folded.ir.json
time_unit = 'days
dimensions { patch = [p0, p1, p2] }
compartments { S, I, R }
stratify(by = patch)
parameters { beta : rate in [0.01, 2.0]  gamma : rate in [0.01, 1.0] }
tables {
  W : patch × patch = [[0.0, 0.5, 0.0],
                       [0.5, 0.0, 0.5],
                       [0.0, 0.0, 0.0]]
}
let N[l in patch] = S[l] + I[l] + R[l]
transitions {
  infection[l in patch] : S[l] --> I[l] @ beta * S[l] * sum(q in patch, W[l, q] * I[q] / N[q])
  recovery[l in patch]  : I[l] --> R[l] @ gamma * I[l]
}
init {
  S[p0] = 990  I[p0] = 10
  S[p1] = 1000
}
simulate { from = 0 'days  to = 30 'days }
