#' SIR with yearly seasonal transmission: a cubic periodic B-spline multiplier
#' whose six coefficients are estimable. Each coefficient's rate gradient is
#' beta times one periodic basis function.
#' @base sir_basic.camdl
#' @adds a periodic_spline multiplier with parameter coefficients
#' @changes the horizon is two years

time_unit = 'days

compartments { S, I, R }

let N = S + I + R

parameters {
  #' per-capita transmission rate before the seasonal multiplier
  #' @symbol β
  beta  : rate     in [0.001, 2.0]
  #' recovery rate; the mean infectious period is 1/gamma
  #' @symbol γ
  gamma : rate     in [0.001, 1.0]
  #' seasonal multiplier at the k-th basis function
  s1    : real 'ratio in [0, 3]
  s2    : real 'ratio in [0, 3]
  s3    : real 'ratio in [0, 3]
  s4    : real 'ratio in [0, 3]
  s5    : real 'ratio in [0, 3]
  s6    : real 'ratio in [0, 3]
  #' total population size
  N0    : count    in [100, 100000]
  #' initial number infectious
  I0    : count    in [1, 1000]
}

forcing {
  season : periodic_spline 'ratio {
    period  = 365 'days
    n_basis = 6
    coefs   = [s1, s2, s3, s4, s5, s6]
  }
}

transitions {
  infection : S --> I  @ beta * season * S * (I / N)
  recovery  : I --> R  @ gamma * I
}

init {
  S = N0 - I0
  I = I0
}

simulate {
  from = 0 'days
  to   = 730 'days
}

scenarios {
  baseline_scenario {
    label = "baseline"
    set = {
      beta  = 0.25
      gamma = 0.2
      s1 = 1.3
      s2 = 1.1
      s3 = 0.8
      s4 = 0.7
      s5 = 0.9
      s6 = 1.2
      N0 = 10000
      I0 = 10
    }
  }
}
