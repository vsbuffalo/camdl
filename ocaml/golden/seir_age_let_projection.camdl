# Stratified SEIR observing a LET-BOUND projection target. A let-bound
# bare identifier in `projected` must inline the let body (a DerivedExpr),
# not fall through to a dangling CumulativeFlow. gh#164/#165 (Defect A').
time_unit = 'days

compartments { S, E, I, R }

dimensions {
  age = [child, adult]
}

stratify(by = age)

let N_local[a in age] = S[a] + E[a] + I[a] + R[a]
# Aggregate infectious count across age strata — the observation target.
let I_total = I[child] + I[adult]

parameters {
  beta  : rate        in [0.001, 0.5]
  sigma : rate        in [0.01, 1.0]
  gamma : rate        in [0.01, 1.0]
  k     : real        in [0.1, 100.0]
}

tables {
  C_age : age × age = [[12.0, 4.0], [4.0, 8.0]]
}

transitions {
  infection[a in age] : S[a] --> E[a]
    @ beta * S[a] * sum(b in age, C_age[a, b] * I[b] / N_local[b])

  progression[a in age] : E[a] --> I[a]  @ sigma * E[a]
  recovery[a in age]    : I[a] --> R[a]  @ gamma * I[a]
}

observations {
  prevalence_total {
    columns          { time : time, prevalence_total : count }
    projected        = I_total
    emit_schedule    = every 7 'days
    prevalence_total ~ neg_binomial(mean = projected, r = k)
  }
}

init {
  S[child] = 4990
  S[adult] = 5000
  I[child] = 10
}

simulate {
  from = 0 'days
  to   = 100 'days
}

scenarios {
  baseline {
    label = "default"
    simulate { to = 100 'days }
    set = {
      beta  = 0.05
      sigma = 0.2
      gamma = 0.1
      k     = 5.0
    }
  }
}
