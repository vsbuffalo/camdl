# invariant: an absolute read() path is W104
# spec: warning-catalog W104
# expect: W104 Warning, E200 Error
# W104 (gh#211): an ABSOLUTE read() path is non-portable and must warn. The
# warning fires on the path STRING, before the file-existence check, so it
# surfaces regardless of whether the absolute file exists on this machine. Since
# this path does not exist here, E200 (file-not-found) also fires — both are
# expected and correct.
#
time_unit = 'days

dimensions {
  patch = [north, south, east]
}

compartments { S, I, R }

stratify(by = patch)

tables {
  N0 : patch = read("/home/alice/data/w104_n0.tsv")
}

parameters {
  beta  : rate  in [0.001, 1.0]
  gamma : rate  in [0.01,  1.0]
  I0    : count in [1, 1000]
}

let N[p in patch] = S[p] + I[p] + R[p]

transitions {
  infection[p in patch]  : S[p] --> I[p]  @ beta * S[p] * I[p] / N[p]
  recovery[p in patch]   : I[p] --> R[p]  @ gamma * I[p]
}

init {
  S[p in patch] = N0[p] - I0
  I[p in patch] = I0
}

simulate {
  from = 0 'days
  to   = 365 'days
}
