# invariant: a compartment referenced nowhere is L402
# spec: warning-catalog L402
# expect: L402 Warning
# Dead-compartment lint (L402). The model is a well-formed SIR — it
# compiles and runs — but declares a fourth compartment `D` (deaths) that
# is referenced nowhere: no transition stoichiometry / source / dest /
# rate, no binding, no init, no observation. The linter flags `D` as a
# dead compartment at Warning severity; compilation still succeeds.
#
time_unit = 'days

compartments { S, I, R, D }

let N = S + I + R

parameters {
  beta  : rate  in [0.001, 2.0]
  gamma : rate  in [0.001, 1.0]
  N0    : count in [100, 100000]
  I0    : count in [1, 1000]
}

transitions {
  infection : S --> I  @ beta * S * (I / N)
  recovery  : I --> R  @ gamma * I
}

init {
  S = N0 - I0
  I = I0
}

simulate {
  from = 0 'days
  to   = 80 'days
}
