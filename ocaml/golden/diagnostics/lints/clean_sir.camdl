# invariant: a well-formed SIR emits no diagnostic
# spec: warning-catalog, all lints
# expect: (none)
# Clean SIR — every compartment is wired into a transition / binding / init.
# This fixture asserts the *absence* of any diagnostic: a well-formed model
# must compile with zero errors, warnings, lints, or infos.
#
time_unit = 'days

compartments { S, I, R }

let N = S + I + R

parameters {
  beta  : rate  in [0.001, 2.0]
  gamma : rate  in [0.001, 1.0]
  N0    : count in [100, 100000]
  I0    : count in [1, 1000]
}

transitions {
  infection : S --> I  @ beta * S * (I / N)
  recovery  : I --> R  @ gamma * I
}

init {
  S = N0 - I0
  I = I0
}

simulate {
  from = 0 'days
  to   = 80 'days
}
