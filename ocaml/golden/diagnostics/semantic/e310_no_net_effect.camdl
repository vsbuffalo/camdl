# invariant: a transition must change some compartment
# spec: §9.1.1
# expect: E310 Error
time_unit = 'days
compartments { S, I, R }
let N = S + I + R
parameters {
  beta  : rate  in [0.001, 2.0]
  gamma : rate  in [0.001, 1.0]
}
transitions {
  infection : S --> I  @ beta * S * (I / N)
  recovery  : I + S --> I + S  @ gamma * I
}
init {
  S = 990
  I = 10
}
simulate { from = 0 'days  to = 80 'days }
