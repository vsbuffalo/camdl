# invariant: rk45 with dimensionless tolerances compiles clean
# spec: warning-catalog E106
# expect: (none)
# gh#166: a well-formed rk45 integrator with dimensionless tolerances compiles
# with zero diagnostics.
#
time_unit = 'days

compartments { S, I, R }

let N = S + I + R

parameters {
  beta  : rate  in [0.001, 2.0]
  gamma : rate  in [0.001, 1.0]
  N0    : count in [100, 100000]
  I0    : count in [1, 1000]
}

transitions {
  infection : S --> I  @ beta * S * (I / N)
  recovery  : I --> R  @ gamma * I
}

init {
  S = N0 - I0
  I = I0
}

simulate {
  from = 0 'days
  to   = 80 'days
  integrator = rk45 { atol = 1e-8  rtol = 1e-6 }
}
