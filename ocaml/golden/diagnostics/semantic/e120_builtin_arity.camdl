# invariant: a built-in function takes its fixed number of arguments
# spec: warning-catalog E120
# expect: E120 Error
time_unit = 'days
compartments { S, I, R }
let N = S + I + R
parameters {
  beta  : rate  in [0.001, 2.0]
  gamma : rate  in [0.001, 1.0]
}
transitions {
  infection : S --> I  @ beta * S * (I / N)
  recovery  : I --> R  @ gamma * I * exp(1, 2)
}
init {
  S = 990
  I = 10
}
simulate { from = 0 'days  to = 80 'days }
