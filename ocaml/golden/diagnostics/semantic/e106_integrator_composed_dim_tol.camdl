# invariant: an integrator tolerance is dimensionless, also when composed
# spec: warning-catalog E106
# expect: E106 Error
# gh#166: net-dimension check rejects a composed dimensioned tolerance that an
# AST-shape (bare EUnit) check would miss — located E106.
#
time_unit = 'days

compartments { S, I, R }

let N = S + I + R

parameters {
  beta  : rate  in [0.001, 2.0]
  gamma : rate  in [0.001, 1.0]
  N0    : count in [100, 100000]
  I0    : count in [1, 1000]
}

transitions {
  infection : S --> I  @ beta * S * (I / N)
  recovery  : I --> R  @ gamma * I
}

init {
  S = N0 - I0
  I = I0
}

simulate {
  from = 0 'days
  to   = 80 'days
  integrator = rk45 { atol = 0.5 * 1 'days }
}
