# invariant: a time in another time unit is converted, not refused
# spec: §5.1, times read as numbers
# expect: (none)
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate in [0.01, 2.0]
  gamma : rate in [0.01, 1.0]
}

let N = S + I + R

transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 10 'weeks }
