# invariant: a count-noise sd may mix a count and its square; psi's P exponent is free there
# spec: §5.6
# expect: I300 Info
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate        in [0.01, 2.0]
  gamma : rate        in [0.01, 1.0]
  N0    : count       in [100, 100000]
  I0    : count       in [1, 1000]
  rho   : probability in [0, 1]
  psi   : positive    in [0, 1]
}

let N = S + I + R

transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
}

observations {
  y {
    columns { time : time, y : count }
    covers = closing_at(time, 7 'days)
    projected = incidence(infection)
    y ~ normal(mean = rho * projected, sd = sqrt(rho * (1 - rho) * projected + (rho * psi * projected)^2))
  }
}

init { S = N0 - I0  I = I0 }

simulate { from = 0 'days  to = 100 'days }
