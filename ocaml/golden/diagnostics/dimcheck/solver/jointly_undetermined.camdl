# invariant: only a product is pinned: I300 names the relation, no error
# spec: §4.4
# expect: I300 Info
time_unit = 'days

compartments { S, I, R, V }

parameters {
  beta  : rate     in [0.01, 2.0]
  gamma : rate     in [0.01, 1.0]
  kappa : positive
  w     : positive
}

let N = S + I + R + V

transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
  coupling  : S --> V @ kappa * w * S * I / N
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
