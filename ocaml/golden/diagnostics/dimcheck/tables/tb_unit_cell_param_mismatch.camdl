# invariant: a table's unit annotation declares its cells' dimension
# spec: §5.1, table values
# expect: E302 Error
time_unit = 'days

compartments { S, I, R }

dimensions { age = [young, old] }

parameters {
  beta  : rate        in [0.01, 2.0]
  gamma : rate        in [0.01, 1.0]
  cov   : probability in [0, 1]
}

tables { mu : age 'per_day = [cov, cov] }

let N = S + I + R

transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
  waning    : R --> S @ mu[young] * R
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
