# invariant: unchecked_dim asserts a dimension for an irregular term, (I + iota)^alpha
# spec: §5.5
# expect: (none)
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate     in [0.01, 2.0]
  gamma : rate     in [0.01, 1.0]
  alpha : positive dim 1 in [0.9, 1.0]
  iota  : count    in [0, 5]
}

let N = S + I + R

transitions {
  infection : S --> I  @ beta * S * unchecked_dim((I + iota) ^ alpha, dim = population, reason = "He et al. alpha-mixing") / N
  recovery  : I --> R  @ gamma * I
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
