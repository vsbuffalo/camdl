# invariant: a duration-typed constant used as a rate is refused
# spec: §5.1, position "transition rate"
# expect: E300 Error
time_unit = 'days
compartments { S, I, R, V }
parameters {
  beta  : rate  in [0.01, 2.0]
  gamma : rate  in [0.01, 1.0]
  N0    : count in [100, 100000]
  I0    : count in [1, 1000]

}
let N = S + I + R + V
let tau : duration = 30 'days
transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
  waning : R --> S @ R * tau
}
init { S = N0 - I0  I = I0  R = 0  V = 0 }

simulate { from = 0 'days  to = 100 'days }
