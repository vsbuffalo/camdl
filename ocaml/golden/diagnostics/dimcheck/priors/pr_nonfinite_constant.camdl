# invariant: a constant prior argument must be finite
# spec: §5.9, validity
# expect: E235 Error
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  gamma : rate ~ log_normal(mu = log(0.0), sigma = 0.5)
}

transitions {
  infection : S --> I  @ beta * S * I / (S + I + R)
  recovery  : I --> R  @ gamma * I
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
