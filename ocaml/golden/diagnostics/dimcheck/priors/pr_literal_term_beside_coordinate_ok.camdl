# invariant: a unit-literal term in the argument's own dimension, beside a coordinate, compiles
# spec: §5.9
# expect: (none)
time_unit = 'days
compartments { S, I, R }
parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  gamma : rate
  m_h : real ~ normal(mu = 0.2, sigma = 0.1)
  delta : rate ~ normal(mu = m_h + 0.1 'per_day, sigma = 0.05)
}
let N = S + I + R

transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ (gamma + delta) * I
}
init { S = 990  I = 10 }

simulate { from = 0 'days  to = 10 'days }
