# invariant: a rate-declared hyperparameter as a log-normal `mu` compiles, with the I316 lint
# spec: §5.9
# expect: I316 Info
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  mu_r  : rate ~ half_normal(sigma = 0.1)
  gamma : rate ~ log_normal(mu = mu_r, sigma = 0.5)
}

transitions {
  infection : S --> I  @ beta * S * I / (S + I + R)
  recovery  : I --> R  @ gamma * I
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
