# invariant: a probability-declared hyperparameter may supply a rate prior's spread
# spec: §5.9
# expect: (none)
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  m     : rate        ~ normal(mu = 0.2, sigma = 0.05)
  s     : probability ~ beta(alpha = 2, beta = 20)
  gamma : rate        ~ normal(mu = m, sigma = s)
}

transitions {
  infection : S --> I  @ beta * S * I / (S + I + R)
  recovery  : I --> R  @ gamma * I
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
