# invariant: gamma and exponential priors on rates, with a rate argument in θ's inverse units
# spec: §5.9
# expect: (none)
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  gamma : rate ~ gamma(shape = 2, rate = 10)
  delta : rate ~ exponential(rate = 2 'days)
}

transitions {
  infection : S --> I  @ beta * S * I / (S + I + R)
  recovery  : I --> R  @ (gamma + delta) * I
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
