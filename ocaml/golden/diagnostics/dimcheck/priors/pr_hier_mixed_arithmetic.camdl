# invariant: arithmetic over hyperparameters of different declared dimensions is valid
# spec: §5.9
# expect: (none)
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  s_rate : rate        ~ half_normal(sigma = 0.1)
  s_prob : probability ~ beta(alpha = 2, beta = 2)
  gamma  : rate        ~ normal(mu = 0.2, sigma = s_rate * s_prob + 0.1)
}

transitions {
  infection : S --> I  @ beta * S * I / (S + I + R)
  recovery  : I --> R  @ gamma * I
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
