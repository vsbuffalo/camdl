# invariant: the log of a rate-declared hyperparameter is a valid log-normal `mu`
# spec: §5.9
# expect: (none)
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  m_h   : rate ~ half_normal(sigma = 0.5)
  gamma : rate ~ log_normal(mu = log(m_h), sigma = 0.5)
}

transitions {
  infection : S --> I  @ beta * S * I / (S + I + R)
  recovery  : I --> R  @ gamma * I
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
