# invariant: dimensionless hyperparameters as log-normal `mu` and `sigma`
# spec: §5.9
# expect: (none)
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  m_h   : real dim 1     ~ normal(mu = -1.6, sigma = 0.5)
  s_h   : positive dim 1 ~ half_normal(sigma = 0.5)
  gamma : rate           ~ log_normal(mu = m_h, sigma = s_h)
}

transitions {
  infection : S --> I  @ beta * S * I / (S + I + R)
  recovery  : I --> R  @ gamma * I
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
