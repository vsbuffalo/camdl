# invariant: a hierarchical prior's arguments are named as the family's, as a constant prior's are
# spec: §5.9, validity
# expect: E231 Error, E233 Error
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  m_h   : real     ~ normal(mu = -1.6, sigma = 0.5)
  s_h   : positive ~ half_normal(sigma = 0.5)
  gamma : rate     ~ log_normal(mean = m_h, sd = s_h)
}

transitions {
  infection : S --> I  @ beta * S * I / (S + I + R)
  recovery  : I --> R  @ gamma * I
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
