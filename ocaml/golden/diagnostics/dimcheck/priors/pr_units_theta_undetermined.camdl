# invariant: a unit literal on a prior of a parameter of undetermined dimension is converted and accepted
# spec: §5.9
# expect: I300 Info
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  gamma : rate
  kappa : positive
  w     : positive ~ normal(mu = 0.2 'per_day, sigma = 0.1 'per_day)
}

transitions {
  infection : S --> I  @ beta * S * I / (S + I + R)
  recovery  : I --> R  @ kappa * w * I
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
