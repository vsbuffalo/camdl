# invariant: a derived quantity built only from pure numbers is dimensionless
# spec: §5.2
# expect: (none)
time_unit = 'days
compartments { S, I, R }
parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  gamma : rate

}
let N = S + I + R

transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
}
init { S = 990  I = 10 }
quantities {
  peak = final(I)
  pw = 2 ^ (peak / peak)
}
simulate { from = 0 'days  to = 10 'days }
