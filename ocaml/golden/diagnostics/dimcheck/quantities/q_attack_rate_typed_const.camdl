# invariant: an attack rate over a population size declared as a typed constant compiles
# spec: §5.2
# expect: (none)
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate in [0.01, 2.0]
  gamma : rate in [0.01, 1.0]
}

let N = S + I + R
let N0 : count = 1000

transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
}

init { S = 990  I = 10 }

quantities {
  attack_rate = final((N0 - S) / N0)
}

simulate { from = 0 'days  to = 100 'days }
