# invariant: the operands of a sum inside a quantity series agree
# spec: §5.1, quantities
# expect: E302 Error
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate     in [0.01, 2.0]
  gamma : rate     in [0.01, 1.0]
  N0    : count    in [100, 100000]
  I0    : count    in [1, 1000]
  t_x   : instant  in [0, 100]
  thr   : count    in [1, 100]
}

let N = S + I + R

transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
}

init { S = N0 - I0  I = I0 }

quantities {
  bad = final(I + gamma)
}

simulate { from = 0 'days  to = 100 'days }
