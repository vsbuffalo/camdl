# invariant: an attack rate over a one-off population size written with 'count compiles
# spec: §5.2
# expect: (none)
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate in [0.01, 2.0]
  gamma : rate in [0.01, 1.0]
}

let N = S + I + R

transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
}

init { S = 990  I = 10 }

quantities {
  attack_rate = final(1 - S / (1000 'count))
}

simulate { from = 0 'days  to = 100 'days }
