# invariant: a count under a parameter exponent is an error
# spec: §5.4
# expect: E301 Error
time_unit = 'days

compartments { S, I, R, V }

parameters {
  beta  : rate     in [0.01, 2.0]
  gamma : rate     in [0.01, 1.0]
  alpha : positive in [0.5, 1.5]
}

let N = S + I + R + V

transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
  mixing    : S --> V @ gamma * S * I ^ alpha / N ^ alpha
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
