# invariant: a rational power of a dimensionless base is valid
# spec: §5.4
# expect: (none)
time_unit = 'days

compartments { S, I, R, V }

parameters {
  beta  : rate     in [0.01, 2.0]
  gamma : rate     in [0.01, 1.0]

}

let N = S + I + R + V

transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
  mixing    : S --> V @ gamma * S * (I / N) ^ 0.5
}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
