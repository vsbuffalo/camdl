# invariant: an exponent too large to represent is reported, never wrapped
# spec: §4.4
# expect: E310 Error
time_unit = 'days
compartments { S, I, R }
parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  gamma : rate

}
let N = S + I + R
transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
  odd : S --> R @ gamma * S * (((I ^ 999999) ^ 999999) ^ 999999) ^ 999999
}
init { S = 990  I = 10 }

simulate { from = 0 'days  to = 10 'days }
