# invariant: a 'count literal added to a population rate is a dimension error
# spec: §5.3
# expect: E302 Error
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  gamma : rate ~ normal(mu = 0.1, sigma = 0.05)
}

transitions {
  infection : S --> I  @ beta * S * I / (S + I + R)
  recovery  : I --> R  @ gamma * I + 5 'count

}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
