# invariant: a literal coefficient inside a product is dimensionless
# spec: §5.2
# expect: E300 Error
time_unit = 'days

compartments { S, I, R }

parameters {
  gamma : rate     in [0.01, 1.0]
  N0    : count    in [100, 100000]
  I0    : count    in [1, 1000]

}

let N = S + I + R

transitions {
  infection : S --> I @ 0.0001 * S * I
  recovery  : I --> R @ gamma * I

}

init { S = N0 - I0  I = I0 }

simulate { from = 0 'days  to = 100 'days }
