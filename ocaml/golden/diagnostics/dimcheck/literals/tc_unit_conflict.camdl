# invariant: a typed constant's unit literals must agree with its kind
# spec: §5.3
# expect: E282 Error
time_unit = 'days

compartments { S, I, R }

let tau : rate = 30 'days
parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  gamma : rate ~ normal(mu = 0.1, sigma = 0.05)
}

transitions {
  infection : S --> I  @ beta * S * I / (S + I + R)
  recovery  : I --> R  @ gamma * I

}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
