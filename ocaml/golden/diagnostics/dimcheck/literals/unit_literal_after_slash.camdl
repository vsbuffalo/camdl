# invariant: a bare unit literal after / is ambiguous (E107)
# spec: §5.3
# expect: E107 Error
time_unit = 'days

compartments { S, I, R }

parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  gamma : rate ~ normal(mu = 0.1, sigma = 0.05)
}

transitions {
  infection : S --> I  @ beta * S * I / (S + I + R)
  recovery  : I --> R  @ I / 5 'days

}

init { S = 990  I = 10 }

simulate { from = 0 'days  to = 100 'days }
