# invariant: unit literals that disagree inside a typed constant are refused
# spec: §5.3
# expect: E282 Error
time_unit = 'days
compartments { S, I, R }
parameters {
  beta  : rate ~ normal(mu = 0.3, sigma = 0.1)
  gamma : rate

}
let N = S + I + R
let tau : rate = 1 'per_day + 1 'days
transitions {
  infection : S --> I @ beta * S * I / N
  recovery  : I --> R @ gamma * I
}
init { S = 990  I = 10 }

simulate { from = 0 'days  to = 10 'days }
