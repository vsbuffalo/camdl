#' SIR whose transmission rate is exp of a cubic B-spline with estimable
#' coefficients: positive for any coefficients, smooth through time, and held
#' at its last value past day 100. Each coefficient's rate gradient is the
#' forcing's value times one basis function.
#' @base bspline_loglink.camdl
#' @adds parameter coefficients, so the rate carries their gradients
#' @changes the window is [0, 100] days with six basis functions

time_unit = 'days

compartments { S, I, R }

let N = S + I + R

parameters {
  #' recovery rate; the mean infectious period is 1/gamma
  #' @symbol γ
  gamma : rate     in [0.001, 1.0]
  #' log transmission rate (per day) at the spline's k-th coefficient
  b1    : real 'ratio in [-6, 1]
  b2    : real 'ratio in [-6, 1]
  b3    : real 'ratio in [-6, 1]
  b4    : real 'ratio in [-6, 1]
  b5    : real 'ratio in [-6, 1]
  b6    : real 'ratio in [-6, 1]
  #' total population size
  N0    : count    in [100, 100000]
  #' initial number infectious
  I0    : count    in [1, 1000]
}

forcing {
  beta_t : bspline 'per_day {
    window  = [0 'days, 100 'days]
    n_basis = 6
    link    = log
    coefs   = [b1, b2, b3, b4, b5, b6]
  }
}

transitions {
  infection : S --> I  @ beta_t * S * (I / N)
  recovery  : I --> R  @ gamma * I
}

init {
  S = N0 - I0
  I = I0
}

simulate {
  from = 0 'days
  to   = 120 'days
}

scenarios {
  baseline_scenario {
    label = "baseline"
    set = {
      gamma = 0.2
      b1 = -1.0
      b2 = -0.9
      b3 = -1.3
      b4 = -1.6
      b5 = -1.4
      b6 = -1.5
      N0 = 10000
      I0 = 10
    }
  }
}
