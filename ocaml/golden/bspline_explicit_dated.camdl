#' SIR whose transmission rate is itself a quadratic B-spline with
#' irregular knots written as calendar dates under an origin: closer knots
#' where the rate is expected to move fastest. The spline is clamped, so it
#' starts at its first coefficient on 2025-01-01 and ends at its last on
#' 2025-04-01, and holds that value to the end of the run.
#' @base sir_basic.camdl
#' @adds a dated, explicit-breakpoint bspline as the transmission rate
#' @changes beta is replaced by the forcing; an origin anchors the calendar

time_unit = 'days
origin    = date("2025-01-01")

compartments { S, I, R }

let N = S + I + R

parameters {
  #' recovery rate; the mean infectious period is 1/gamma
  #' @symbol γ
  gamma : rate     in [0.001, 1.0]
  #' total population size
  N0    : count    in [100, 100000]
  #' initial number infectious
  I0    : count    in [1, 1000]
}

forcing {
  # Four intervals, degree 2: 4 − 1 + 2 = 6 coefficients, per day.
  beta_t : bspline 'per_day {
    breakpoints = [date("2025-01-01"), date("2025-01-20"), date("2025-02-01"),
                   date("2025-02-20"), date("2025-04-01")]
    degree      = 2
    coefs       = [0.45, 0.5, 0.3, 0.2, 0.25, 0.3]
  }
}

transitions {
  infection : S --> I  @ beta_t * S * (I / N)
  recovery  : I --> R  @ gamma * I
}

init {
  S = N0 - I0
  I = I0
}

simulate {
  from = 0 'days
  to   = 120 'days
}

scenarios {
  baseline_scenario {
    label = "baseline"
    set = {
      gamma = 0.2
      N0    = 10000
      I0    = 10
    }
  }
}
