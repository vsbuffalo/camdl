# gh#116 follow-up coverage: pin the NegBinomial.dispersion strict
# dim-check.
#
# NegBinomial's `dispersion` (the `r` shape parameter in the
# pomp/Stan/He et al. parameterisation) is a Gamma shape — purely
# dimensionless. A count there is a wrong-units bug. The existing
# `propagate st ~ctx nb.dispersion dimensionless` call only BOUND
# Unknown dim vars to dimensionless; a Known count silently slipped
# through. Audit-flagged 2026-05-27 alongside the four other
# observation likelihood arguments.
#
# Expected diagnostic AFTER fix: E304, "NegBinomial `dispersion`
# must be dimensionless."

time_unit = 'days

compartments { S, I, R }

let N = S + I + R

parameters {
  beta  : rate
  gamma : rate
}

transitions {
  infection : S --> I  @ beta * S * I / N
  recovery  : I --> R  @ gamma * I
}

observations {
  weekly_cases {
    columns       { time : time, weekly_cases : count }
    projected     = incidence(infection)
    emit_schedule = every 7 'days
    # BUG: NegBinomial's `r` / `dispersion` must be dimensionless.
    # `projected` (a count) is wrong-units; the intended dispersion
    # value would be a fixed scalar or a dimensionless parameter.
    weekly_cases ~ neg_binomial(mean = projected, r = projected)
  }
}

init {
  S = 990
  I = 10
}

simulate {
  from = 0 'days
  to   = 100 'days
}
