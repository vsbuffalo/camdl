# gh#116 follow-up coverage: pin the BetaBinomial.alpha strict
# dim-check.
#
# BetaBinomial's `alpha` (and `beta`) are shape parameters of the
# underlying Beta distribution — both dimensionless by definition.
# A count there is a wrong-units bug. Audit-flagged on 2026-05-27
# as unpinned coverage; `alpha` and `beta` share the same code path
# in `dimcheck.ml` (lines 766-778) so this golden pins both via the
# alpha path. A `e304_beta_binomial_beta_is_count.camdl` is
# intentionally NOT added — pinning the same wiring twice via
# different fields would be redundant.
#
# Expected diagnostic AFTER fix: E304, "BetaBinomial `alpha` must
# be dimensionless."

time_unit = 'days

compartments { S, I, R }

let N = S + I + R

parameters {
  beta  : rate
  gamma : rate
}

transitions {
  infection : S --> I  @ beta * S * I / N
  recovery  : I --> R  @ gamma * I
}

observations {
  detection_overdisp {
    columns       { time : time, detection_overdisp : count }
    projected     = prevalence(I)
    emit_schedule = every 14 'days
    # BUG: BetaBinomial's `alpha` is a Beta-distribution shape param
    # — dimensionless by definition. A count is a wrong-units error.
    detection_overdisp ~ beta_binomial(n = 1000, alpha = projected, beta = 1.0)
  }
}

init {
  S = 990
  I = 10
}

simulate {
  from = 0 'days
  to   = 100 'days
}
