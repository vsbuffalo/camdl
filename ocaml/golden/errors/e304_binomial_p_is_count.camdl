# gh#116 / 2026-05-26 upstream OCaml-compiler review Critical #6:
# observation likelihood arguments are dimensionally unchecked.
#
# Negative golden — `binomial(n = N, p = projected)` where
# `projected = prevalence(I)` is a count. The `p` argument MUST be a
# probability (dimensionless on [0, 1]); a count for `p` is a textbook
# missing-`/N` bug — turns a prevalence likelihood into a count-valued
# probability. Without the fix, the blanket `permissive_dim <- true`
# in `lib/ir/dimcheck.ml::pass1` (around the observations iteration)
# suppresses E304/E302 and this model compiles silently.
#
# Expected diagnostic AFTER fix: E304 (dimension mismatch) on the `p`
# argument of `binomial`, pointing at the observation block.

time_unit = 'days

compartments { S, I, R }

let N = S + I + R

parameters {
  beta  : rate
  gamma : rate
}

transitions {
  infection : S --> I  @ beta * S * I / N
  recovery  : I --> R  @ gamma * I
}

observations {
  prevalence_signal {
    columns       { time : time, prevalence_signal : count }
    projected     = prevalence(I)
    emit_schedule = every 7 'days
    # BUG (silently accepted today): p must be a probability,
    # but `projected` is a count. The intent was almost certainly
    # `p = projected / N`.
    prevalence_signal ~ binomial(n = 1000, p = projected)
  }
}

init {
  S = 990
  I = 10
}

simulate {
  from = 0 'days
  to   = 100 'days
}
