# SEIR with three surveillance streams — one per under-covered likelihood family.
#
# Golden-coverage purpose: the only model golden exercising the `poisson`,
# `normal`, and `beta_binomial` observation likelihoods (spec §12.2), each placed
# where it is epidemiologically defensible rather than as a bare syntax exercise:
#   - weekly case reports  ~ normal        (large counts → normal approximation)
#   - weekly disease deaths ~ poisson      (rare, well-ascertained events)
#   - periodic serosurvey   ~ beta_binomial (over-dispersed test positivity)
#
# `incidence(disease_death)` observes flow through an outflow transition.

time_unit = 'days

compartments { S, E, I, R }

let N = S + E + I + R

parameters {
  beta      : rate
  sigma     : rate
  gamma     : rate
  mu_d      : rate         # disease-induced mortality
  rho       : probability  # case reporting fraction
  sigma_rel : positive     # relative SD of the normal case-count noise
  kappa     : positive     # beta-binomial concentration (overdispersion)
  n_sero    : count        # serosurvey sample size
  N0        : count
  I0        : count
}

transitions {
  infection     : S --> E  @ beta * S * I / N
  progression   : E --> I  @ sigma * E
  recovery      : I --> R  @ gamma * I
  disease_death : I -->     @ mu_d * I
}

observations {
  # Large weekly case counts — normal approximation; SD scales with the mean.
  cases {
    columns       { time : time, cases : count }
    projected     = incidence(infection)
    emit_schedule = every 7 'days
    cases         ~ normal(mean = rho * projected, sd = sigma_rel * projected)
  }

  # Rare, well-ascertained deaths — Poisson.
  deaths {
    columns       { time : time, deaths : count }
    projected     = incidence(disease_death)
    emit_schedule = every 7 'days
    deaths        ~ poisson(rate = projected)
  }

  # Periodic serosurvey: positives out of n_sero, over-dispersed positivity.
  # True seroprevalence R/N sets the mean; kappa controls overdispersion.
  seroprev {
    columns       { time : time, seroprev : count }
    projected     = R / N
    emit_schedule = every 90 'days
    seroprev      ~ beta_binomial(n = n_sero,
                                  alpha = projected * kappa,
                                  beta  = (1 - projected) * kappa)
  }
}

init {
  S = N0 - I0
  I = I0
}

simulate {
  from = 0 'days
  to   = 1 'years
}

scenarios {
  baseline {
    label = "multi-stream surveillance"
    set = {
      beta      = 0.45
      sigma     = 0.2
      gamma     = 0.1
      mu_d      = 0.002
      rho       = 0.2
      sigma_rel = 0.3
      kappa     = 40.0
      n_sero    = 1000
      N0        = 1000000
      I0        = 100
    }
  }
}
