# SEIR with an Erlang-3 latent period, expressed with the `via` clause.
# Desugars to the manual stratified-`consecutive` staging in seir_erlang.camdl:
# `E`'s residence is Erlang-3 (mean 1/sigma, CV 1/√3), so `onset` stages E into
# E_s1, E_s2, E_s3 with per-stage rate 3*sigma. The bare `E` in the FOI
# denominator sums all three stages for free (PopSum).
time_unit = 'days

compartments { S, E, I, R }

parameters {
  beta  : rate in [0.001, 2.0]
  sigma : rate in [0.01, 1.0]
  gamma : rate in [0.01, 1.0]
}

transitions {
  infection : S --> E  @ beta * S * I / (S + E + I + R)
  onset     : E --> I  via erlang(stages = 3, rate = sigma)
  recovery  : I --> R  @ gamma * I
}

init {
  S = 990
  E = 5
  I = 5
}

simulate {
  from = 0 'days
  to   = 160 'days
}

scenarios {
  baseline {
    label = "default  (latent ≈ 5d)"
    simulate { to = 160 'days }
    set = {
      beta  = 0.3
      sigma = 0.2
      gamma = 0.1
    }
  }
}
