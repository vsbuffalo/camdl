# The LEGITIMATE side of L404, pinned as a fixture because it is the
# property most likely to regress. Two laboratories report on the same
# incidence through their own ascertainment fractions (`rho_a`, `rho_b`).
# They share one projection — `incidence(infection)` — but they are two
# distinct observation processes on one latent quantity, so the joint
# likelihood is CORRECT and this model must keep working.
#
# camdl cannot tell this apart from the duplicated-file case in
# `l404_two_streams_one_projection.camdl`: whether two files hold the same
# measurements is a fact about how the data was produced, not about the
# model. So L404 fires here too — and must stay a Warning. The expectation
# below is the assertion that matters: exactly one L404, at Warning
# severity, and NO error, so the model still compiles. (The corpus
# check/compile parity test independently pins that neither pipeline turns
# it into a rejection.)
#
# expect: L404 Warning
time_unit = 'days

compartments { S, I, R }

let N = S + I + R

parameters {
  beta  : rate        in [0.001, 2.0]
  gamma : rate        in [0.001, 1.0]
  rho_a : probability in [0.0,   1.0]
  rho_b : probability in [0.0,   1.0]
  N0    : count       in [100,   100000]
  I0    : count       in [1,     1000]
}

transitions {
  infection : S --> I  @ beta * S * (I / N)
  recovery  : I --> R  @ gamma * I
}

observations {
  lab_a {
    columns       { time : time, lab_a : count }
    projected     = incidence(infection)
    emit_schedule = every 7 'days
    lab_a         ~ poisson(rate = rho_a * projected)
  }

  lab_b {
    columns       { time : time, lab_b : count }
    projected     = incidence(infection)
    emit_schedule = every 7 'days
    lab_b         ~ poisson(rate = rho_b * projected)
  }
}

init {
  S = N0 - I0
  I = I0
}

simulate {
  from = 0 'days
  to   = 80 'days
}
