# End-to-end no-sudo install test on the exact environment from gh#205:
# Ubuntu 18.04 — glibc 2.27, system cmake 3.10 (< the 3.13 nlopt needs).
# The build runs as a non-root user with NO sudo in the image, so any attempt
# by install.sh to escalate fails loudly ("sudo: command not found"). A green
# build proves install.sh produced a working `camdl` with zero privilege.
#
# Build and run from the repo root — both steps, the run is the test:
#   docker build -f tests/install/Dockerfile.ubuntu1804 -t camdl-install-test .
#   docker run --rm --security-opt seccomp=unconfined \
#     --security-opt apparmor=unconfined camdl-install-test
#
# What it exercises that the unit tests can't:
#   - the portable-CMake fetch (system cmake 3.10 is present but too old)
#   - the opam prebuilt-binary download + install into ~/.local/bin
#   - a real glibc-2.27 from-source build of both toolchains
#
# NOTE: this is an amd64 image and a full from-source build (OCaml switch
# compile + Rust release). It is SLOW — minutes on a native amd64 host, far
# longer under emulation on Apple Silicon. Run it on an amd64 CI runner or
# host, not in the inner loop.

FROM ubuntu:18.04

# Genuine base prerequisites only — exactly what ensure_base_tools checks for
# (make, git, curl, tar, unzip, and C/C++ compilers that link) — plus
# ca-certificates (TLS), bubblewrap (so opam can sandbox), and the OLD system
# cmake (3.10) to reproduce gh#205 friction #1. Installed as root *in the image
# build*; this stands in for "an admin provisioned the box". The camdl install
# runs unprivileged and `sudo` is deliberately NOT present.
#
# `unzip` and a working C compiler are prerequisites, not conveniences: opam
# refuses to init without unzip, and the OCaml switch is compiled from source.
# Leaving them out is what made this job fail in ~45s on every run since it was
# added (gh#755).
#
# `libc6-dev` is spelled out because `gcc` only *recommends* it, and this image
# installs with --no-install-recommends deliberately. Without it gcc is on PATH
# and cannot link, and the OCaml compiler build dies at "C compiler cannot
# create executables".
#
# `g++` is here for the vendored nlopt, which declares a CXX CMake project and
# so configures for a C++ compiler even though camdl links only the C library.
#
# Users are pointed at build-essential instead, which is the one apt name that
# reliably carries all three; the explicit set here keeps the image minimal,
# which is the point of this test.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      make git curl tar unzip gcc g++ libc6-dev ca-certificates bubblewrap cmake \
 && rm -rf /var/lib/apt/lists/*

# Non-root user, no sudo. If install.sh reaches for root, the build dies here.
RUN useradd --create-home builder
USER builder
WORKDIR /home/builder/camdl
COPY --chown=builder:builder . .

# The image stops here, holding only a provisioned box and the source. The
# install itself runs in `docker run` (see .github/workflows/install-e2e.yml),
# NOT in a RUN layer: opam sandboxes package builds with bubblewrap, bubblewrap
# needs an unprivileged user namespace, and buildkit gates that behind an
# `insecure` entitlement requiring a custom builder. Under `docker run` with
# seccomp and apparmor unconfined, the sandbox is genuinely active — which is
# the configuration a real user gets, and therefore the one worth testing.
#
# Running it here instead would leave two bad options: fail on the sandbox, or
# pass `NO_SANDBOX=1` and turn the job green by deleting what it verifies.
CMD ["bash", "tests/install/run-install-test.sh"]
