# R3 integration fixture (proposal 2026-10-27-estimable-bsplines §8.1): a small
# chain-binomial SEIR whose transmission rate is exp of a cubic B-spline with
# six estimable coefficients, observed as daily onsets. N0 = 10^4 over 60 days;
# the window ends two weeks before the last observation, so the last 14 days
# run on the held value.

time_unit = 'days

compartments { S, E, I, R }

let N = S + E + I + R

parameters {
  sigma : rate        in [0.01, 1.0]
  gamma : rate        in [0.01, 1.0]
  rho   : probability in [0.01, 1.0]
  b1    : real 'ratio in [-8, 2]
  b2    : real 'ratio in [-8, 2]
  b3    : real 'ratio in [-8, 2]
  b4    : real 'ratio in [-8, 2]
  b5    : real 'ratio in [-8, 2]
  b6    : real 'ratio in [-8, 2]
  N0    : count       in [100, 1000000]
  E0    : count       in [0, 1000]
  I0    : count       in [0, 1000]
}

forcing {
  beta_t : bspline 'per_day {
    window  = [0 'days, 46 'days]
    n_basis = 6
    link    = log
    coefs   = [b1, b2, b3, b4, b5, b6]
  }
}

transitions {
  infection   : S --> E @ beta_t * S * (I / N)
  progression : E --> I @ sigma * E
  recovery    : I --> R @ gamma * I
}

init {
  S = N0 - E0 - I0
  E = E0
  I = I0
}

observations {
  onsets {
    columns       { time : time, onsets : count }
    covers        = closing_at(time, 1 'days)
    projected     = incidence(progression)
    emit_schedule = every 1 'days
    onsets        ~ poisson(rate = rho * projected)
  }
}

simulate {
  from = 0 'days
  to   = 60 'days
}
