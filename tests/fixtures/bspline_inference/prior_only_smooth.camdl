# R3 prior-only fixture (proposal 2026-10-27-estimable-bsplines §8.1): with
# X0 = 0 every flow is zero, and the one observation stream (PGAS needs one)
# has every value missing in the test, so the complete-data likelihood is
# constant and PGAS+NUTS should draw the stated prior: tau ~
# exponential(5.99), a and b their normals, and the curvature part of the
# coefficients with covariance E[tau^2]/kappa^2 · Omega^+.

time_unit = 'days

dimensions { mode = [m1, m2, m3, m4] }

compartments { X, D }

parameters {
  a       : real 'ratio ~ normal(mu = -1.0, sigma = 0.6)
  b       : real [1/T] ~ normal(mu = 0.0, sigma = 0.01)
  tau     : positive 'ratio in [1e-6, 2.5] ~ exponential(rate = 5.99)
  z[mode] : real 'ratio ~ normal(mu = 0.0, sigma = 1.0)
}

forcing {
  f : bspline 'per_day {
    window  = [0 'days, 60 'days]
    n_basis = 6
    link    = log
    coefs   = smooth(level = a, slope = b, scale = tau, modes = z, per = 1 'weeks)
  }
}

transitions {
  decay : X --> D @ f * X
}

init { X = 0 }

observations {
  removals {
    columns       { time : time, removals : count }
    covers        = closing_at(time, 1 'days)
    projected     = incidence(decay)
    emit_schedule = every 1 'days
    removals      ~ poisson(rate = projected)
  }
}

simulate {
  from = 0 'days
  to   = 60 'days
}
