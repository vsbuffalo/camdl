# Minimal 2-patch SIR with a read() population table and weekly case
# observations — a self-contained fixture for `camdl mre fit`.
#
# `pop.tsv` is read at COMPILE time and baked into the IR; it appears
# nowhere in fit.toml. It is exactly the kind of covariate file an MRE
# bundle must capture by asking the compiler (camdlc --emit-deps).
time_unit = 'days

dimensions { patch = [north, south] }

compartments { S, I, R }

stratify(by = patch)

tables {
  N0 : patch = read("pop.tsv")
}

parameters {
  beta  : rate        in [0.001, 1.0]
  gamma : rate        in [0.01,  1.0]
  rho   : probability in [0.01,  1.0]
  k     : positive    in [1, 100]
  I0    : count       in [1, 100]
}

let N[p in patch] = S[p] + I[p] + R[p]

transitions {
  infection[p in patch] : S[p] --> I[p]  @ beta * S[p] * I[p] / N[p]
  recovery[p in patch]  : I[p] --> R[p]  @ gamma * I[p]
}

observations {
  cases_north {
    columns       { time : time, cases_north : count }
    projected     = incidence(infection_north)
    emit_schedule = every 7 'days
    cases_north   ~ neg_binomial(mean = rho * projected, r = k)
  }
  cases_south {
    columns       { time : time, cases_south : count }
    projected     = incidence(infection_south)
    emit_schedule = every 7 'days
    cases_south   ~ neg_binomial(mean = rho * projected, r = k)
  }
}

init {
  S[p in patch] = N0[p] - I0
  I[p in patch] = I0
}

simulate {
  from = 0 'days
  to   = 84 'days
}
