# Base: none — root model
# Adds: nothing
# Changes: nothing
#
# What this model is. A closed population in three compartments: susceptible
# (S), infectious (I) and recovered (R). Susceptible individuals become
# infectious at a per-person rate `foi`, the force of infection, which is the
# transmission rate times the infectious fraction of the population. Infectious
# individuals recover and stay immune.
#
# What it is fitted to. One stream, `cases`: the weekly count of new
# infections, of which a fraction `rho` is reported. It is here so that a
# comparison of two variants has an observation model to compare. The model is
# compiled only; no data file exists for it.
#
# This is the reference model of the `camdl diff` fixture set. Every other file
# in this directory is this model with one thing changed, and the tests in
# `rust/crates/diff/tests` state what the diff of each against this one must
# report.

time_unit = 'days

compartments { S, I, R }

let N = S + I + R
let foi = beta * I / N

parameters {
  #' per-capita transmission rate
  beta  : rate        in [0.001, 2.0]
  #' recovery rate; the mean infectious period is 1/gamma
  gamma : rate        in [0.001, 1.0] ~ log_normal(mu = -2.3, sigma = 0.5)
  #' fraction of infections that are reported
  rho   : probability in [0.01, 1.0]
  #' total population size
  N0    : count       in [100, 100000]
  #' initial number infectious
  I0    : count       in [1, 1000]
}

transitions {
  infection : S --> I  @ foi * S
  recovery  : I --> R  @ gamma * I
}

observations {
  cases {
    columns       { time : time, cases : count }
    covers        = closing_at(time, 7 'days)
    projected     = incidence(infection)
    emit_schedule = every 7 'days
    cases         ~ poisson(rate = rho * projected)
  }
}

init {
  S = N0 - I0
  I = I0
}

simulate {
  from = 0 'days
  to   = 80 'days
}

quantities {
  peak_infectious = max(I)
}
