# Corner case: a transition RATE that references `dt` (Ir.Dt, gh#54).
#
# The infection hazard carries an explicit (dt / tau) factor, so the realized
# substep LENGTH enters the rate EXPRESSION itself — not only the
# 1-exp(-rate·dt) kernel. Under StepPolicy::Exact, off-grid observation times
# shorten substeps, so the realized dt_actual diverges from the nominal grid
# dt. This fixture pins that the rate is evaluated at dt_actual (EvalCtx.dt =
# the clipped substep), end-to-end across the forward producer (step_one) and
# the PGAS complete-data density. Evaluating it at the grid dt instead would
# silently change the likelihood — the regression the dt-rate Exact-clip gate
# guards. See docs/dev/proposals/2026-06-07-scheduling-spine-v2.md §A (StepClock).
time_unit = 'days
compartments { S, I, R }
let N = S + I + R
parameters {
  beta  : rate in [0.05, 3.0]
  gamma : rate in [0.01, 1.0]
  tau   : duration in [0.1, 10.0]
}
transitions {
  infection : S --> I  @ beta * S * I / N * (dt / tau)
  recovery  : I --> R  @ gamma * I
}
observations {
  cases {
    columns       { time : time, cases : count }
    projected     = incidence(infection)
    emit_schedule = every 2.5 'days
    cases         ~ poisson(rate = projected)
  }
}
init {
  S = 990
  I = 10
}
simulate {
  from = 0 'days
  to   = 20 'days
}
