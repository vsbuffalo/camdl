# Corner case: OFF-GRID OBSERVATION CADENCE.
# every = 2.5 'days places obs at 2.5, 5.0, 7.5, 10.0, ... — alternating off and
# on the dt=1 grid. The PF steps exactly to each; PGAS snaps to the grid (and two
# sub-dt obs can collide). Pins obs-alignment behavior.
time_unit = 'days
compartments { S, I, R }
let N = S + I + R
parameters {
  beta  : rate in [0.05, 3.0]
  gamma : rate in [0.01, 1.0]
}
transitions {
  infection : S --> I  @ beta * S * I / N
  recovery  : I --> R  @ gamma * I
}
observations {
  cases {
    columns       { time : time, cases : count }
    projected     = incidence(infection)
    emit_schedule = every 2.5 'days
    cases         ~ poisson(rate = projected)
  }
}
init {
  S = 990
  I = 10
}
simulate {
  from = 0 'days
  to   = 20 'days
}
