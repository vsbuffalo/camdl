{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/camdl/camdl/ir/schema.json",
  "title": "Camdl IR",
  "description": "Stochastic compartmental model IR schema v0.6",
  "type": "object",
  "required": [
    "name",
    "version",
    "compartments",
    "transitions",
    "ode_equations",
    "time_functions",
    "tables",
    "interventions",
    "observations",
    "parameters",
    "initial_conditions",
    "output",
    "simulation"
  ],
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "time_unit": { "type": "string", "description": "Time axis unit: days/weeks/months/years (and per_* aliases)." },
    "description": { "type": ["string", "null"] },
    "origin": {
      "type": ["string", "null"],
      "description": "ISO date (YYYY-MM-DD) mapped to internal t=0; the I/O calendar anchor (2026-05-22 calendar-time)."
    },
    "origin_rata_die": {
      "type": ["integer", "null"],
      "description": "Compiler-derived proleptic-Gregorian day number of `origin`; the runtime reads this instead of re-parsing the origin string."
    },

    "compartments": {
      "type": "array",
      "items": { "$ref": "#/definitions/compartment" }
    },

    "transitions": {
      "type": "array",
      "items": { "$ref": "#/definitions/transition" }
    },

    "ode_equations": {
      "type": "array",
      "items": { "$ref": "#/definitions/ode_equation" }
    },

    "time_functions": {
      "type": "array",
      "items": { "$ref": "#/definitions/time_function" }
    },

    "tables": {
      "type": "array",
      "items": { "$ref": "#/definitions/table" }
    },

    "interventions": {
      "type": "array",
      "items": { "$ref": "#/definitions/intervention" }
    },

    "observations": {
      "type": "array",
      "items": { "$ref": "#/definitions/observation_model" }
    },

    "parameters": {
      "type": "array",
      "items": { "$ref": "#/definitions/parameter" }
    },

    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "expr"],
        "properties": {
          "name": { "type": "string" },
          "expr": { "$ref": "#/definitions/expr" }
        },
        "additionalProperties": false
      }
    },

    "per_eval_bindings": {
      "comment": "gh#272 LICM: param/table-only loop-invariant bindings, topologically ordered. Produced by the loop-invariant-code-motion pass (post-autodiff, CAMDL_LICM); omitted when empty (default). Same shape as `bindings`, but bodies may be param-carrying and are cached once per theta-stable scope rather than per step.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "expr"],
        "properties": {
          "name": { "type": "string" },
          "expr": { "$ref": "#/definitions/expr" }
        },
        "additionalProperties": false
      }
    },

    "initial_conditions": { "$ref": "#/definitions/initial_conditions" },

    "output": { "$ref": "#/definitions/output_config" },

    "simulation": { "$ref": "#/definitions/simulation_config" },

    "identity_tracked_compartments": {
      "description": "Compartments whose individuals carry tracked IDs (individual-sampling layer). Forward-reachable closure from `#[lineage]` event destinations and parent pools. Absent/empty when no `#[lineage]` annotations exist.",
      "type": "array",
      "items": { "type": "string" }
    }
  },

  "definitions": {
    "compartment": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["integer", "real"] }
      }
    },

    "expr": {
      "type": "object",
      "oneOf": [
        {
          "required": ["const"],
          "properties": {
            "const": { "type": "number" }
          },
          "additionalProperties": false
        },
        {
          "required": ["param"],
          "properties": {
            "param": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "required": ["pop"],
          "properties": {
            "pop": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "required": ["pop_sum"],
          "properties": {
            "pop_sum": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        {
          "required": ["time"],
          "properties": {
            "time": { "type": "null" }
          },
          "additionalProperties": false
        },
        {
          "required": ["bin_op"],
          "properties": {
            "bin_op": {
              "type": "object",
              "required": ["op", "left", "right"],
              "properties": {
                "op": { "type": "string", "enum": ["add", "sub", "mul", "div", "pow", "min", "max"] },
                "left": { "$ref": "#/definitions/expr" },
                "right": { "$ref": "#/definitions/expr" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["un_op"],
          "properties": {
            "un_op": {
              "type": "object",
              "required": ["op", "arg"],
              "properties": {
                "op": { "type": "string", "enum": ["neg", "exp", "log", "sqrt", "abs", "floor", "ceil"] },
                "arg": { "$ref": "#/definitions/expr" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["cond"],
          "properties": {
            "cond": {
              "type": "object",
              "required": ["pred", "then", "else"],
              "properties": {
                "pred": { "$ref": "#/definitions/expr" },
                "then": { "$ref": "#/definitions/expr" },
                "else": { "$ref": "#/definitions/expr" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["time_func"],
          "properties": {
            "time_func": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["table_lookup"],
          "properties": {
            "table_lookup": {
              "type": "object",
              "required": ["table", "indices"],
              "properties": {
                "table": { "type": "string" },
                "indices": { "type": "array", "items": { "$ref": "#/definitions/expr" }, "minItems": 1 }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["projected"],
          "properties": {
            "projected": { "type": "null" }
          },
          "additionalProperties": false
        },
        {
          "required": ["reduce"],
          "properties": {
            "reduce": { "type": "array", "items": { "$ref": "#/definitions/expr" } }
          },
          "additionalProperties": false
        },
        {
          "required": ["binding_ref"],
          "properties": {
            "binding_ref": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "comment": "gh#272 LICM: reference to a model-level per_eval_binding by name. Param/table-only loop-invariant; cached once per theta-stable scope. Produced only by the LICM pass (post-autodiff); never present in default-off IR.",
          "required": ["per_eval_ref"],
          "properties": {
            "per_eval_ref": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "comment": "Per-observation auxiliary data column referenced by name in a likelihood (e.g. binomial `n = tested`). Resolved by the Rust binder against the bound aux columns of the enclosing observation stream; evaluates per observation. Only valid inside a likelihood argument expression (2026-06-10 observation data-entry §3, §6.1).",
          "required": ["obs_column_ref"],
          "properties": {
            "obs_column_ref": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },

    "stoichiometry_entry": {
      "type": "array",
      "items": [{ "type": "string" }, { "type": "integer" }],
      "minItems": 2,
      "maxItems": 2
    },

    "transition_metadata": {
      "type": "object",
      "properties": {
        "origin_kind": { "type": ["string", "null"] },
        "source_compartment": { "type": ["string", "null"] },
        "dest_compartment": { "type": ["string", "null"] }
      }
    },

    "transition": {
      "type": "object",
      "required": ["name", "stoichiometry", "rate"],
      "properties": {
        "name": { "type": "string" },
        "stoichiometry": {
          "type": "array",
          "items": { "$ref": "#/definitions/stoichiometry_entry" }
        },
        "rate": { "$ref": "#/definitions/expr" },
        "metadata": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/transition_metadata" }
          ]
        },
        "lineage": {
          "description": "Lineage (individual-sampling) annotation for `#[lineage]` transitions. Absent for ordinary transitions.",
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/definitions/transition_lineage" }
          ]
        }
      }
    },

    "transition_lineage": {
      "type": "object",
      "required": ["is_lineage_event", "parent_pool_weights"],
      "properties": {
        "is_lineage_event": { "type": "boolean" },
        "parent_pool_weights": {
          "description": "Linear decomposition of the rate over parent pools: (compartment, per-pool weight expression) pairs. For `beta*S*I/N` with parent I this is [[\"I\", <beta*S/N>]].",
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": [
              { "type": "string" },
              { "$ref": "#/definitions/expr" }
            ]
          }
        }
      },
      "additionalProperties": false
    },

    "ode_equation": {
      "type": "object",
      "required": ["compartment", "derivative"],
      "properties": {
        "compartment": { "type": "string" },
        "derivative": { "$ref": "#/definitions/expr" }
      }
    },

    "time_func_kind": {
      "type": "object",
      "oneOf": [
        {
          "required": ["sinusoidal"],
          "properties": {
            "sinusoidal": {
              "type": "object",
              "required": ["amplitude", "period", "phase", "baseline"],
              "properties": {
                "amplitude": { "$ref": "#/definitions/expr" },
                "period": { "$ref": "#/definitions/expr" },
                "phase": { "$ref": "#/definitions/expr" },
                "baseline": { "$ref": "#/definitions/expr" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["piecewise"],
          "properties": {
            "piecewise": {
              "type": "object",
              "required": ["breakpoints", "values"],
              "properties": {
                "breakpoints": { "type": "array", "items": { "$ref": "#/definitions/expr" } },
                "values": { "type": "array", "items": { "$ref": "#/definitions/expr" } }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["interpolated"],
          "properties": {
            "interpolated": {
              "type": "object",
              "required": ["times", "values", "method"],
              "properties": {
                "times": { "type": "array", "items": { "$ref": "#/definitions/expr" } },
                "values": { "type": "array", "items": { "$ref": "#/definitions/expr" } },
                "method": { "type": "string", "enum": ["linear", "spline"] }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["periodic"],
          "properties": {
            "periodic": {
              "type": "object",
              "required": ["period", "values"],
              "properties": {
                "period": { "$ref": "#/definitions/expr" },
                "values": { "type": "array", "items": { "$ref": "#/definitions/expr" } }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },

    "time_function": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "$ref": "#/definitions/time_func_kind" }
      }
    },

    "table": {
      "type": "object",
      "required": ["name", "values", "out_of_bounds"],
      "properties": {
        "name": { "type": "string" },
        "values": { "type": "array", "items": { "$ref": "#/definitions/expr" } },
        "out_of_bounds": { "type": "string", "enum": ["error"] }
      }
    },

    "intervention_schedule": {
      "type": "object",
      "oneOf": [
        {
          "required": ["at_times"],
          "properties": {
            "at_times": { "type": "array", "items": { "type": "number" } }
          },
          "additionalProperties": false
        },
        {
          "required": ["at_times_expr"],
          "properties": {
            "at_times_expr": {
              "type": "array",
              "items": { "$ref": "#/definitions/expr" }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["recurring"],
          "properties": {
            "recurring": {
              "type": "object",
              "required": ["start", "period", "end"],
              "properties": {
                "start": { "type": "number" },
                "period": { "type": "number" },
                "end": { "type": "number" }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },

    "obs_reducer": {
      "type": "string",
      "enum": ["latest", "sum", "mean", "max"]
    },

    "trigger_quantity": {
      "type": "object",
      "required": ["observed"],
      "properties": {
        "observed": {
          "type": "object",
          "required": ["stream", "reducer"],
          "properties": {
            "stream": { "type": "string" },
            "window": { "type": "number" },
            "reducer": { "$ref": "#/definitions/obs_reducer" }
          }
        }
      },
      "additionalProperties": false
    },

    "trigger_threshold": {
      "type": "object",
      "oneOf": [
        {
          "required": ["const"],
          "properties": { "const": { "type": "number" } },
          "additionalProperties": false
        },
        {
          "required": ["param"],
          "properties": { "param": { "type": "string" } },
          "additionalProperties": false
        }
      ]
    },

    "trigger_expr": {
      "type": "object",
      "oneOf": [
        {
          "required": ["cmp"],
          "properties": {
            "cmp": {
              "type": "object",
              "required": ["lhs", "op", "rhs"],
              "properties": {
                "lhs": { "$ref": "#/definitions/trigger_quantity" },
                "op":  { "type": "string", "enum": ["lt", "le", "gt", "ge", "eq", "neq"] },
                "rhs": { "$ref": "#/definitions/trigger_threshold" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["and"],
          "properties": {
            "and": {
              "type": "array",
              "items": { "$ref": "#/definitions/trigger_expr" },
              "minItems": 2, "maxItems": 2
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["or"],
          "properties": {
            "or": {
              "type": "array",
              "items": { "$ref": "#/definitions/trigger_expr" },
              "minItems": 2, "maxItems": 2
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["not"],
          "properties": { "not": { "$ref": "#/definitions/trigger_expr" } },
          "additionalProperties": false
        }
      ]
    },

    "reactive_trigger": {
      "type": "object",
      "required": ["when", "after", "once"],
      "properties": {
        "when": { "$ref": "#/definitions/trigger_expr" },
        "after": { "type": "number" },
        "once": { "type": "boolean" },
        "cooldown": { "type": "number" }
      }
    },

    "fire_source": {
      "type": "object",
      "oneOf": [
        {
          "required": ["scheduled"],
          "properties": {
            "scheduled": { "$ref": "#/definitions/intervention_schedule" }
          },
          "additionalProperties": false
        },
        {
          "required": ["reactive"],
          "properties": {
            "reactive": { "$ref": "#/definitions/reactive_trigger" }
          },
          "additionalProperties": false
        }
      ]
    },

    "action": {
      "type": "object",
      "oneOf": [
        {
          "required": ["fraction_transfer"],
          "properties": {
            "fraction_transfer": {
              "type": "object",
              "required": ["src", "dst", "fraction"],
              "properties": {
                "src": { "type": "string" },
                "dst": { "type": "string" },
                "fraction": { "$ref": "#/definitions/expr" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["absolute_transfer"],
          "properties": {
            "absolute_transfer": {
              "type": "object",
              "required": ["src", "dst", "count"],
              "properties": {
                "src": { "type": "string" },
                "dst": { "type": "string" },
                "count": { "$ref": "#/definitions/expr" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["set"],
          "properties": {
            "set": {
              "type": "object",
              "required": ["compartment", "value"],
              "properties": {
                "compartment": { "type": "string" },
                "value": { "$ref": "#/definitions/expr" }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },

    "intervention": {
      "type": "object",
      "required": ["name", "fire", "actions"],
      "properties": {
        "name": { "type": "string" },
        "base_name": { "type": "string" },
        "fire": { "$ref": "#/definitions/fire_source" },
        "actions": { "type": "array", "items": { "$ref": "#/definitions/action" } },
        "kind": { "type": "string", "enum": ["scenario", "event"] }
      }
    },

    "projection": {
      "type": "object",
      "oneOf": [
        {
          "required": ["cumulative_flow"],
          "properties": {
            "cumulative_flow": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "required": ["cumulative_flow_sum"],
          "properties": {
            "cumulative_flow_sum": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        {
          "required": ["current_pop"],
          "properties": {
            "current_pop": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "required": ["current_pop_sum"],
          "properties": {
            "current_pop_sum": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        {
          "required": ["derived_expr"],
          "properties": {
            "derived_expr": { "$ref": "#/definitions/expr" }
          },
          "additionalProperties": false
        }
      ]
    },

    "likelihood": {
      "type": "object",
      "oneOf": [
        {
          "required": ["poisson"],
          "properties": {
            "poisson": {
              "type": "object",
              "required": ["rate"],
              "properties": {
                "rate": { "$ref": "#/definitions/expr" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["neg_binomial"],
          "properties": {
            "neg_binomial": {
              "type": "object",
              "required": ["mean", "dispersion"],
              "properties": {
                "mean": { "$ref": "#/definitions/expr" },
                "dispersion": { "$ref": "#/definitions/expr" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["normal"],
          "properties": {
            "normal": {
              "type": "object",
              "required": ["mean", "sd"],
              "properties": {
                "mean": { "$ref": "#/definitions/expr" },
                "sd": { "$ref": "#/definitions/expr" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["binomial"],
          "properties": {
            "binomial": {
              "type": "object",
              "required": ["n", "p"],
              "properties": {
                "n": { "$ref": "#/definitions/expr" },
                "p": { "$ref": "#/definitions/expr" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["beta_binomial"],
          "properties": {
            "beta_binomial": {
              "type": "object",
              "required": ["n", "alpha", "beta"],
              "properties": {
                "n": { "$ref": "#/definitions/expr" },
                "alpha": { "$ref": "#/definitions/expr" },
                "beta": { "$ref": "#/definitions/expr" }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },

    "observation_schedule": {
      "oneOf": [
        {
          "type": "object",
          "required": ["at_times"],
          "properties": {
            "at_times": { "type": "array", "items": { "type": "number" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["regular"],
          "properties": {
            "regular": {
              "type": "object",
              "required": ["start", "step", "end"],
              "properties": {
                "start": { "type": "number" },
                "step": { "type": "number" },
                "end": { "type": "number" }
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },

    "observation_model": {
      "type": "object",
      "required": ["name", "source", "columns", "scored", "projection", "likelihood"],
      "properties": {
        "name": { "type": "string" },
        "source": { "type": "string" },
        "columns": {
          "type": "array",
          "items": { "$ref": "#/definitions/obs_column" }
        },
        "scored": { "type": "string" },
        "emit_schedule": { "$ref": "#/definitions/observation_schedule" },
        "stratum": {
          "type": "array",
          "default": [],
          "items": { "$ref": "#/definitions/stratum_key" }
        },
        "projection": { "$ref": "#/definitions/projection" },
        "likelihood": { "$ref": "#/definitions/likelihood" }
      },
      "additionalProperties": false
    },

    "stratum_key": {
      "type": "object",
      "required": ["dim", "level"],
      "properties": {
        "dim": { "type": "string" },
        "level": { "type": "string" }
      },
      "additionalProperties": false
    },

    "obs_column": {
      "type": "object",
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string" },
        "role": {
          "oneOf": [
            { "type": "string", "enum": ["time"] },
            {
              "type": "object",
              "required": ["dim"],
              "properties": { "dim": { "type": "string" } },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["value"],
              "properties": {
                "value": { "type": "string", "enum": ["rate", "probability", "count", "positive", "real", "instant", "duration"] }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },

    "prior_dist": {
      "type": "object",
      "oneOf": [
        {
          "required": ["uniform"],
          "properties": {
            "uniform": {
              "type": "object",
              "required": ["lower", "upper"],
              "properties": {
                "lower": { "type": "number" },
                "upper": { "type": "number" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["normal"],
          "properties": {
            "normal": {
              "type": "object",
              "required": ["mean", "sd"],
              "properties": {
                "mean": { "type": "number" },
                "sd": { "type": "number" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["log_normal"],
          "properties": {
            "log_normal": {
              "type": "object",
              "required": ["mu", "sigma"],
              "properties": {
                "mu": { "type": "number" },
                "sigma": { "type": "number" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["half_normal"],
          "properties": {
            "half_normal": {
              "type": "object",
              "required": ["sigma"],
              "properties": {
                "sigma": { "type": "number" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["beta"],
          "properties": {
            "beta": {
              "type": "object",
              "required": ["alpha", "beta"],
              "properties": {
                "alpha": { "type": "number" },
                "beta": { "type": "number" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["gamma"],
          "properties": {
            "gamma": {
              "type": "object",
              "required": ["shape", "rate"],
              "properties": {
                "shape": { "type": "number" },
                "rate": { "type": "number" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["exponential"],
          "properties": {
            "exponential": {
              "type": "object",
              "required": ["rate"],
              "properties": {
                "rate": { "type": "number" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["log_uniform"],
          "properties": {
            "log_uniform": {
              "type": "object",
              "required": ["lower", "upper"],
              "properties": {
                "lower": { "type": "number" },
                "upper": { "type": "number" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["truncated_normal"],
          "properties": {
            "truncated_normal": {
              "type": "object",
              "required": ["mean", "sd", "lower", "upper"],
              "properties": {
                "mean": { "type": "number" },
                "sd": { "type": "number" },
                "lower": { "type": "number" },
                "upper": { "type": "number" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["fixed"],
          "properties": {
            "fixed": { "type": "number" }
          },
          "additionalProperties": false
        }
      ]
    },

    "hierarchical_prior": {
      "type": "object",
      "required": ["kind", "args", "pool_over"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["uniform", "normal", "log_normal", "half_normal", "beta", "gamma", "exponential"]
        },
        "args": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/expr" }
        },
        "pool_over": { "type": "string" }
      },
      "additionalProperties": false
    },

    "prior_spec": {
      "comment": "Prior on an estimated parameter (gh#191). Exactly one of: flat, a single-level dist, or a hierarchical prior.",
      "oneOf": [
        { "type": "string", "enum": ["flat"] },
        {
          "type": "object",
          "required": ["dist"],
          "properties": { "dist": { "$ref": "#/definitions/prior_dist" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["hierarchical"],
          "properties": { "hierarchical": { "$ref": "#/definitions/hierarchical_prior" } },
          "additionalProperties": false
        }
      ]
    },

    "param_value": {
      "comment": "Tagged union (gh#191): a parameter is a Fixed constant, an Estimated parameter (inference config lives here), or Required (supplied at runtime).",
      "type": "object",
      "required": ["mode"],
      "oneOf": [
        {
          "required": ["mode", "value"],
          "properties": { "mode": { "const": "fixed" }, "value": { "type": "number" } },
          "additionalProperties": false
        },
        {
          "required": ["mode", "prior", "transform"],
          "properties": {
            "mode": { "const": "estimated" },
            "init": { "type": "number" },
            "bounds": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "prior": { "$ref": "#/definitions/prior_spec" },
            "transform": { "type": "string", "enum": ["log", "logit", "identity"] }
          },
          "additionalProperties": false
        },
        {
          "required": ["mode"],
          "properties": { "mode": { "const": "required" } },
          "additionalProperties": false
        }
      ]
    },

    "parameter": {
      "type": "object",
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "$ref": "#/definitions/param_value" },
        "param_kind": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "enum": ["rate", "probability", "count", "positive", "real", "instant", "duration"] }
          ]
        },
        "param_dim": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 }
          ]
        }
      }
    },

    "initial_conditions": {
      "type": "object",
      "oneOf": [
        {
          "required": ["explicit"],
          "properties": {
            "explicit": {
              "type": "object",
              "additionalProperties": { "type": "number" }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["parameterized"],
          "properties": {
            "parameterized": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/expr" }
            }
          },
          "additionalProperties": false
        },
        {
          "required": ["from_distribution"],
          "properties": {
            "from_distribution": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/prior_dist" }
            }
          },
          "additionalProperties": false
        }
      ]
    },

    "output_schedule": {
      "oneOf": [
        {
          "type": "object",
          "required": ["regular"],
          "properties": {
            "regular": {
              "type": "object",
              "required": ["start", "step", "end"],
              "properties": {
                "start": { "type": "number" },
                "step": { "type": "number" },
                "end": { "type": "number" }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["at_times"],
          "properties": {
            "at_times": { "type": "array", "items": { "type": "number" } }
          },
          "additionalProperties": false
        }
      ]
    },

    "output_config": {
      "type": "object",
      "required": ["times", "format", "trajectory", "observations"],
      "properties": {
        "times": { "$ref": "#/definitions/output_schedule" },
        "format": { "type": "string", "enum": ["tsv", "csv"] },
        "trajectory": { "type": "boolean" },
        "observations": { "type": "boolean" }
      }
    },

    "simulation_config": {
      "type": "object",
      "required": ["t_start", "t_end", "time_semantics"],
      "properties": {
        "t_start": { "type": "number" },
        "t_end": { "type": "number" },
        "time_semantics": { "type": "string", "enum": ["continuous", "discrete"] },
        "dt": { "type": ["number", "null"] },
        "rng_seed": { "type": ["integer", "null"] },
        "integrator": {
          "type": "object",
          "required": ["method"],
          "properties": {
            "method": { "type": "string", "enum": ["rk4", "rk45"] },
            "atol": { "type": ["number", "null"] },
            "rtol": { "type": ["number", "null"] }
          }
        }
      }
    }
  }
}
