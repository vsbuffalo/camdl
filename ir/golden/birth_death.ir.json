{
  "ir_version": "0.26",
  "validated_by": "hand-curated-ir-golden",
  "model": {
    "name": "birth_death",
    "version": "0.3",
    "time_unit": "days",
    "description": "Linear birth-death process: ∅ → X at lambda*X, X → ∅ at mu*X. Poisson steady state when lambda < mu.",
    "compartments": [
      {
        "name": "X",
        "kind": "integer"
      }
    ],
    "transitions": [
      {
        "name": "birth",
        "stoichiometry": [
          [
            "X",
            1
          ]
        ],
        "rate": {
          "bin_op": {
            "op": "mul",
            "left": {
              "param": "lambda"
            },
            "right": {
              "pop": "X"
            }
          }
        },
        "metadata": {
          "origin_kind": "inflow",
          "source_compartment": null,
          "dest_compartment": "X"
        }
      },
      {
        "name": "death",
        "stoichiometry": [
          [
            "X",
            -1
          ]
        ],
        "rate": {
          "bin_op": {
            "op": "mul",
            "left": {
              "param": "mu"
            },
            "right": {
              "pop": "X"
            }
          }
        },
        "metadata": {
          "origin_kind": "outflow",
          "source_compartment": "X",
          "dest_compartment": null
        }
      }
    ],
    "ode_equations": [],
    "time_functions": [],
    "tables": [],
    "interventions": [],
    "observations": [
      {
        "name": "count",
        "source": "count",
        "columns": [
          { "name": "time", "role": "time" },
          { "name": "count", "role": { "value": "count" } }
        ],
        "scored": "count",
        "emit_schedule": {
          "regular": {
            "start": 1.0,
            "step": 1.0,
            "end": 50.0
          }
        },
        "projection": {
          "current_pop": "X"
        },
        "likelihood": {
          "poisson": {
            "rate": {
              "expr": {
                "projected": null
              }
            }
          }
        }
      }
    ],
    "parameters": [
      {"name": "lambda", "value": {"mode": "fixed", "value": 0.1}, "param_kind": null, "param_dim": null},
      {"name": "mu", "value": {"mode": "fixed", "value": 0.15}, "param_kind": null, "param_dim": null}
    ],
    "initial_conditions": {
      "explicit": {
        "X": 100
      }
    },
    "output": {
      "times": {
        "regular": {
          "start": 0.0,
          "step": 1.0
        }
      },
      "format": "tsv",
      "trajectory": true,
      "observations": true
    },
    "simulation": {
      "t_start": 0.0,
      "t_end": 50.0,
      "time_semantics": "continuous",
      "dt": null,
      "rng_seed": 42
    }
  }
}
