{
  "ir_version": "0.36",
  "validated_by": "hand-curated-ir-golden",
  "model": {
    "name": "two_state",
    "version": "0.3",
    "time_unit": "days",
    "description": "Reversible two-state Markov chain A ↔ B. Analytic equilibrium: A/(A+B) = beta_r/(alpha+beta_r).",
    "compartments": [
      {
        "name": "A",
        "kind": "integer"
      },
      {
        "name": "B",
        "kind": "integer"
      }
    ],
    "transitions": [
      {
        "name": "forward",
        "stoichiometry": [
          [
            "A",
            -1
          ],
          [
            "B",
            1
          ]
        ],
        "rate": {
          "bin_op": {
            "op": "mul",
            "left": {
              "param": "alpha"
            },
            "right": {
              "pop": "A"
            }
          }
        },
        "metadata": {
          "origin_kind": "transfer",
          "source_compartment": "A",
          "dest_compartment": "B"
        }
      },
      {
        "name": "backward",
        "stoichiometry": [
          [
            "B",
            -1
          ],
          [
            "A",
            1
          ]
        ],
        "rate": {
          "bin_op": {
            "op": "mul",
            "left": {
              "param": "beta_r"
            },
            "right": {
              "pop": "B"
            }
          }
        },
        "metadata": {
          "origin_kind": "transfer",
          "source_compartment": "B",
          "dest_compartment": "A"
        }
      }
    ],
    "ode_equations": [],
    "time_functions": [],
    "tables": [],
    "interventions": [],
    "observations": [
      {
        "name": "state_A",
        "source": "state_A",
        "columns": [
          { "name": "time", "role": "time" },
          { "name": "state_A", "role": { "value": "count" } }
        ],
        "scored": "state_A",
        "emit_schedule": {
          "regular": {
            "start": 1.0,
            "step": 1.0,
            "end": 100.0
          }
        },
        "projection": {
          "current_pop": "A"
        },
        "likelihood": {
          "poisson": {
            "rate": {
              "expr": {
                "projected": null
              }
            }
          }
        }
      }
    ],
    "parameters": [
      {"name": "alpha", "value": {"mode": "fixed", "value": 0.5}, "param_kind": null, "param_dim": null},
      {"name": "beta_r", "value": {"mode": "fixed", "value": 0.3}, "param_kind": null, "param_dim": null}
    ],
    "initial_conditions": {
      "A": { "deterministic": { "const": 80 } },
      "B": { "deterministic": { "const": 20 } }
    },
    "output": {
      "times": {
        "regular": {
          "start": 0.0,
          "step": 1.0
        }
      },
      "format": "tsv",
      "trajectory": true,
      "observations": true
    },
    "simulation": {
      "t_start": 0.0,
      "t_end": 100.0,
      "time_semantics": "continuous",
      "dt": null,
      "rng_seed": 42
    }
  }
}
