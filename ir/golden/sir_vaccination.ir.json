{
  "ir_version": "0.22",
  "validated_by": "hand-curated-ir-golden",
  "model": {
    "name": "sir_vaccination",
    "version": "0.3",
    "time_unit": "days",
    "description": "SIR with a scheduled supplementary immunisation activity (SIA) at day 100",
    "compartments": [
      {
        "name": "S",
        "kind": "integer"
      },
      {
        "name": "I",
        "kind": "integer"
      },
      {
        "name": "R",
        "kind": "integer"
      }
    ],
    "transitions": [
      {
        "name": "infection",
        "stoichiometry": [
          [
            "S",
            -1
          ],
          [
            "I",
            1
          ]
        ],
        "rate": {
          "bin_op": {
            "op": "mul",
            "left": {
              "bin_op": {
                "op": "mul",
                "left": {
                  "param": "beta"
                },
                "right": {
                  "pop": "S"
                }
              }
            },
            "right": {
              "bin_op": {
                "op": "div",
                "left": {
                  "pop": "I"
                },
                "right": {
                  "pop_sum": [
                    "S",
                    "I",
                    "R"
                  ]
                }
              }
            }
          }
        },
        "metadata": {
          "origin_kind": "transmission",
          "source_compartment": "S",
          "dest_compartment": "I"
        }
      },
      {
        "name": "recovery",
        "stoichiometry": [
          [
            "I",
            -1
          ],
          [
            "R",
            1
          ]
        ],
        "rate": {
          "bin_op": {
            "op": "mul",
            "left": {
              "param": "gamma"
            },
            "right": {
              "pop": "I"
            }
          }
        },
        "metadata": {
          "origin_kind": "intrinsic",
          "source_compartment": "I",
          "dest_compartment": "R"
        }
      }
    ],
    "ode_equations": [],
    "time_functions": [],
    "tables": [],
    "interventions": [
      {
        "name": "sia_campaign",
        "fire": {
          "scheduled": {
            "at_times": [
              100.0
            ]
          }
        },
        "actions": [
          {
            "fraction_transfer": {
              "src": "S",
              "dst": "R",
              "fraction": {
                "param": "vaccine_coverage"
              }
            }
          }
        ]
      }
    ],
    "observations": [
      {
        "name": "reported_cases",
        "source": "reported_cases",
        "columns": [
          { "name": "time", "role": "time" },
          { "name": "reported_cases", "role": { "value": "count" } }
        ],
        "scored": "reported_cases",
        "emit_schedule": {
          "regular": {
            "start": 7.0,
            "step": 7.0,
            "end": 365.0
          }
        },
        "projection": {
          "cumulative_flow": "infection"
        },
        "likelihood": {
          "neg_binomial": {
            "mean": {
              "projected": null
            },
            "dispersion": {
              "param": "rho"
            }
          }
        }
      }
    ],
    "parameters": [
      {"name": "beta", "value": {"mode": "fixed", "value": 0.3}, "param_kind": null, "param_dim": null},
      {"name": "gamma", "value": {"mode": "fixed", "value": 0.1}, "param_kind": null, "param_dim": null},
      {"name": "vaccine_coverage", "value": {"mode": "fixed", "value": 0.5}, "param_kind": null, "param_dim": null},
      {"name": "rho", "value": {"mode": "fixed", "value": 10.0}, "param_kind": null, "param_dim": null}
    ],
    "initial_conditions": {
      "explicit": {
        "S": 990,
        "I": 10,
        "R": 0
      }
    },
    "output": {
      "times": {
        "regular": {
          "start": 0.0,
          "step": 7.0,
          "end": 365.0
        }
      },
      "format": "tsv",
      "trajectory": true,
      "observations": true
    },
    "simulation": {
      "t_start": 0.0,
      "t_end": 365.0,
      "time_semantics": "continuous",
      "dt": null,
      "rng_seed": 42
    }
  }
}
