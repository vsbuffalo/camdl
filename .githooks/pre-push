#!/bin/bash
# Pre-push hook: catch what CI catches, before CI has to catch it.
# Mirror of .github/workflows/ci.yml's `test` job, minus the Linux-
# specific setup. Skip with: git push --no-verify.
#
# Rule of thumb: if CI would fail, this must fail too. No exceptions.
# The last time this hook let a CI failure through (2026-04-17, commit
# 19677a0), the root cause was `cargo check --tests` compiling tests
# without running them. Don't repeat the mistake — run the actual tests.

set -e

# ── OCaml: compile + tests ────────────────────────────────────────────
echo "pre-push: OCaml build..."
(cd ocaml && dune build 2>&1) || {
    echo "error: OCaml build failed. Fix before pushing."
    exit 1
}

echo "pre-push: OCaml tests..."
(cd ocaml && dune runtest 2>&1) || {
    echo "error: OCaml tests failed. Fix before pushing."
    exit 1
}

# ── Rust: build + clippy + actual tests (not just --check) ────────────
# Run the tests, not just a compile-check: `cargo check --tests` once let
# runtime/assertion failures slip to CI (2026-04-17). `cargo test --workspace`
# compiles AND runs everything (incl. doctests), sequentially per binary.
# sccache, if installed, caches the compile (empty RUSTC_WRAPPER = unset, a
# no-op without it). (cargo-nextest was tried but its parallel launch burst
# wedges macOS syspolicyd / code-signing — see the Makefile test-fast note.)
echo "pre-push: Rust build + tests..."
SCCACHE="$(command -v sccache 2>/dev/null)"
(cd rust && RUSTC_WRAPPER="$SCCACHE" cargo test --workspace --no-fail-fast 2>&1) || {
    echo "error: Rust tests failed. Fix before pushing."
    exit 1
}

echo "pre-push: clippy..."
# `--workspace` is required, not decoration. `rust/Cargo.toml` declares the
# workspace root as a package of its own (`camdl-tests`), so a bare
# `cargo clippy` lints only that package and compiles `sim`, `cli` and `io`
# as dependencies, which clippy-driver never inspects (gh#743).
(cd rust && cargo clippy --workspace --all-targets -- -D warnings 2>&1) || {
    echo "error: clippy failed. Fix before pushing."
    exit 1
}

# ── Golden files: regenerate and check for unintended drift ───────────
# CI runs `make update-golden` then diffs every path it regenerates. Mirror it
# here so a schema/grammar change that forgot to update goldens is caught
# locally. `make update-golden` writes ocaml/corner/regression/reactive corpora;
# the diff must cover ALL of them — reactive (tests/fixtures/reactive/ir) and
# regression (tests/fixtures/regression/ir) live OUTSIDE ir/golden|ocaml/golden,
# so omitting them lets a reactive/regression compile-drift slip through.
GOLDEN_PATHS="ir/golden/ ocaml/golden/ tests/fixtures/reactive/ir/ tests/fixtures/regression/ir/"
echo "pre-push: golden files unchanged..."
make -s update-golden > /dev/null 2>&1 || {
    echo "error: make update-golden failed."
    exit 1
}
if ! git diff --quiet $GOLDEN_PATHS 2>/dev/null; then
    echo "error: golden files changed after regeneration. Either:"
    echo "  - commit the intentional update: git add $GOLDEN_PATHS && git commit"
    echo "  - or revert: git checkout -- $GOLDEN_PATHS"
    echo ""
    git --no-pager diff --stat $GOLDEN_PATHS 2>/dev/null | head -20
    exit 1
fi

# ── Integration: shell out to the built binary against fixtures ───────
# `make test-integration` runs tests/test_ocaml_to_rust.sh — the script
# that actually exercises `camdl simulate batch FILE` end-to-end against
# golden fixtures. This is the layer that caught the CI failure on
# 2026-04-17 (a rename from `experiment` to `simulate batch` that the
# compile-only check happily missed). Keep it in.
echo "pre-push: integration tests..."
make -s test-integration 2>&1 | tail -5
if [ "${PIPESTATUS[0]}" -ne 0 ]; then
    echo "error: integration tests failed. Fix before pushing."
    exit 1
fi

echo "pre-push: all checks passed."
